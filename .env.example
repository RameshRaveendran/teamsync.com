# ==========================================
# 🔹 ENVIRONMENT CONFIGURATION FILE
# ==========================================
# Copy this file to .env and fill in your values
# Never commit .env file to git

# ==========================================
# 🔹 SERVER CONFIG
# ==========================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# ==========================================
# 🔹 DATABASE CONFIG
# ==========================================

# MongoDB connection URI
# Format: mongodb://username:password@host:port/database
# Examples:
# Local: mongodb://localhost:27017/teamsync
# MongoDB Atlas: mongodb+srv://username:password@cluster0.abc123.mongodb.net/teamsync
MONGO_URI=mongodb://localhost:27017/teamsync

# ==========================================
# 🔹 JWT CONFIG
# ==========================================

# JWT Secret key (use a strong, random string)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# JWT expiration time (default: 7d = 7 days)
JWT_EXPIRE=7d

# ==========================================
# 🔹 CORS CONFIG (optional)
# ==========================================

# Allowed origins for CORS
# Examples: http://localhost:3000,http://localhost:5000,https://example.com
CORS_ORIGIN=*

# ==========================================
# 🔹 RATE LIMITING (optional)
# ==========================================

# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=false

# Max requests per window (e.g., 100 requests)
RATE_LIMIT_MAX=100

# Time window in minutes (e.g., 15 minutes)
RATE_LIMIT_WINDOW=15

# ==========================================
# 🔹 EMAIL CONFIG (optional, for future)
# ==========================================

# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email sender address
EMAIL_FROM=noreply@teamsync.com

# ==========================================
# 🔹 CLOUDINARY CONFIG (optional, for file uploads)
# ==========================================

CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# 🔹 LOGGING CONFIG (optional)
# ==========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path (optional)
LOG_FILE=logs/app.log
