<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - TeamSync</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar') %>
    
    <div class="main-content">
      <%- include('../partials/navbar') %>
      
      <div class="content">
        <div class="page-header">
          <h1>📊 Dashboard</h1>
          <p>Welcome back, <span id="userName">User</span>!</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon">📁</div>
            <div class="stat-info">
              <p class="stat-label">Total Projects</p>
              <h3 class="stat-number" id="totalProjects">0</h3>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon">✓</div>
            <div class="stat-info">
              <p class="stat-label">Tasks Assigned</p>
              <h3 class="stat-number" id="totalTasks">0</h3>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon">🔔</div>
            <div class="stat-info">
              <p class="stat-label">Notifications</p>
              <h3 class="stat-number" id="totalNotifications">0</h3>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-info">
              <p class="stat-label">Your Role</p>
              <h3 class="stat-number role-badge" id="userRole">--</h3>
            </div>
          </div>
        </div>

        <!-- Recent Projects -->
        <div class="dashboard-section">
          <div class="section-header">
            <h2>🚀 Recent Projects</h2>
            <a href="/project/create" class="btn btn-sm btn-primary" id="createProjectBtn" style="display: none;">+ New Project</a>
          </div>

          <div id="recentProjects" class="projects-grid">
            <div class="loading-skeleton"></div>
            <div class="loading-skeleton"></div>
            <div class="loading-skeleton"></div>
          </div>
        </div>

        <!-- Recent Tasks -->
        <div class="dashboard-section">
          <div class="section-header">
            <h2>✅ Assigned Tasks</h2>
            <a href="/tasks" class="btn btn-sm btn-secondary">View All</a>
          </div>

          <div id="recentTasks" class="tasks-table">
            <table>
              <thead>
                <tr>
                  <th>Task</th>
                  <th>Project</th>
                  <th>Status</th>
                  <th>Assigned</th>
                  <th>Due</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="tasksBody">
                <tr class="loading-row">
                  <td colspan="6" class="text-center">Loading tasks...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script>
    requireAuth();

    const user = getUser();
    if (!user) window.location.href = '/login';

    // Initialize navbar
    initializeNavbar('Dashboard');

    // Set user name in header
    document.getElementById('userName').textContent = user.name || 'User';
    
    // Set user role
    document.getElementById('userRole').textContent = user.role || 'Member';

    // Show create project button for Admin and Manager
    if (user.role === 'Admin' || user.role === 'Manager') {
      document.getElementById('createProjectBtn').style.display = 'block';
    }

    const loadDashboard = async () => {
      try {
        // Load stats
        const projects = await api.getProjects();
        const tasks = await api.getTasks();
        const notifications = await api.getNotifications();

        // Update stats
        document.getElementById('totalProjects').textContent = projects.length || 0;
        document.getElementById('totalTasks').textContent = tasks.filter(t => t.status !== 'Completed').length || 0;
        document.getElementById('totalNotifications').textContent = notifications.filter(n => !n.read).length || 0;

        // Load recent projects
        loadRecentProjects(projects);

        // Load recent tasks
        loadRecentTasks(tasks);

      } catch (error) {
        showError(error);
      }
    };

    const loadRecentProjects = (projects) => {
      const container = document.getElementById('recentProjects');
      const recent = projects.slice(0, 3);

      if (recent.length === 0) {
        const isManagerOrAdmin = user.role === 'Admin' || user.role === 'Manager';
        container.innerHTML = `
          <div class="empty-state">
            <p>No projects yet</p>
            ${isManagerOrAdmin ? '<a href="/project/create" class="btn btn-sm btn-primary">Create First Project</a>' : ''}
          </div>
        `;
        return;
      }

      container.innerHTML = recent.map(project => `
        <div class="project-card">
          <div class="card-header">
            <h3>${project.title}</h3>
            <span class="badge badge-${project.status.toLowerCase()}">${project.status}</span>
          </div>
          <p class="card-desc">${project.description || 'No description'}</p>
          <div class="card-footer">
            <small>Created ${formatDate(project.createdAt)}</small>
            <a href="/project/${project._id}" class="btn btn-xs btn-primary">View</a>
          </div>
        </div>
      `).join('');
    };

    const loadRecentTasks = (tasks) => {
      const tbody = document.getElementById('tasksBody');
      const recent = tasks.slice(0, 5);

      if (recent.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center">No tasks assigned to you</td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = recent.map(task => `
        <tr>
          <td><strong>${task.title}</strong></td>
          <td>${task.project?.title || 'N/A'}</td>
          <td><span class="badge badge-${task.status.toLowerCase()}">${task.status}</span></td>
          <td>${task.assignedTo?.name || 'Unassigned'}</td>
          <td>${task.dueDate ? formatDate(task.dueDate) : 'No due date'}</td>
          <td>
            <a href="/task/${task._id}" class="btn btn-xs btn-primary">View</a>
          </td>
        </tr>
      `).join('');
    };

    // Load on page load
    loadDashboard();

    // Reload every 30 seconds
    setInterval(loadDashboard, 30000);
  </script>
</body>
</html>
